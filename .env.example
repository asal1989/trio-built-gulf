# ---------------------------------------------------------------------------
# Trio Built Gulf — environment variables
# Copy to .env for local work. In production set these in Railway (Variables).
# NEVER commit real values.
# ---------------------------------------------------------------------------

# Postgres connection string. Railway: reference the Postgres service, e.g.
#   ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/triobuiltgulf"

# Public site address (used in emails, canonical links and the sitemap).
SITE_URL="https://triobuiltgulf.ae"

# Long random string (32+ chars). Signs local-development file links.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Shared secret for the scheduled maintenance endpoint (follow-up reminders).
#   Same generator as AUTH_SECRET.
CRON_SECRET=""

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM_SALES="Trio Built Gulf <sales@triobuiltgulf.ae>"
EMAIL_FROM_INFO="Trio Built Gulf <info@triobuiltgulf.ae>"

# --- File storage (any S3-compatible bucket: Railway Bucket, Cloudflare R2, AWS S3)
# Leave S3_BUCKET empty in local development: files go to .data/uploads instead.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# true for most non-AWS providers (R2, MinIO, Railway buckets)
S3_FORCE_PATH_STYLE="true"

# --- Optional ---------------------------------------------------------------
# Only if the site is ever served from a sub-path.
NEXT_PUBLIC_BASE_PATH=""
